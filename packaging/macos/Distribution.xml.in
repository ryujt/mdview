<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>mdview @VERSION@</title>
    <welcome file="WELCOME.html" mime-type="text/html"/>
    <conclusion file="CONCLUSION.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check><allowed-os-versions><os-version min="13.0"/></allowed-os-versions></volume-check>
    <choices-outline><line choice="mdview"/></choices-outline>
    <choice id="mdview" visible="false" title="mdview app and CLI">
        <pkg-ref id="camp.tools.mdview.pkg"/>
    </choice>
    <pkg-ref id="camp.tools.mdview.pkg" version="@VERSION@" onConclusion="none">mdview-component.pkg</pkg-ref>
</installer-gui-script>
